DATABASE_URL=postgresql://rootly_ai:rootly_ai@localhost:5433/rootly_ai

API_PORT=3001

# Used to encrypt/decrypt stored GitHub access tokens (AES-256-GCM key material).
GITHUB_TOKEN_ENCRYPTION_KEY=change-me-to-a-random-secret

# Used by the Phase 5 AI investigation agent.
OPENAI_API_KEY=
INVESTIGATION_MODEL=gpt-4o-mini

# Phase 6 reproduction sandbox. See packages/reproduction/README.md.
REPRODUCTION_ENABLED=true
REPRODUCTION_TIMEOUT_MS=60000
REPRODUCTION_MEMORY_LIMIT=1g
REPRODUCTION_CPU_LIMIT=1
REPRODUCTION_MAX_OUTPUT_BYTES=100000
REPRODUCTION_DOCKER_IMAGE=rootly.ai-reproduction-sandbox

# Phase 7 fix engine. Reuses REPRODUCTION_MEMORY_LIMIT/CPU_LIMIT/DOCKER_IMAGE above.
# See packages/fix-engine/README.md.
FIX_ENABLED=true
FIX_VALIDATION_TIMEOUT_MS=120000
FIX_MAX_FILES=5
FIX_MAX_CHANGED_LINES=100
FIX_MAX_PATCH_BYTES=50000

# Phase 8 GitHub PR automation. Reuses the same encrypted repository token as Phase 4.
# See packages/github/README.md.
PR_CREATION_ENABLED=true

NEXT_PUBLIC_API_URL=http://localhost:3001

POSTGRES_USER=rootly_ai
POSTGRES_PASSWORD=rootly_ai
POSTGRES_DB=rootly_ai
