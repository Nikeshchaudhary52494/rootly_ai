DATABASE_URL=postgresql://incident_ai:incident_ai@localhost:5433/incident_ai

API_PORT=3001

# Used to encrypt/decrypt stored GitHub access tokens (AES-256-GCM key material).
GITHUB_TOKEN_ENCRYPTION_KEY=change-me-to-a-random-secret

# Used by the Phase 5 AI investigation agent.
OPENAI_API_KEY=
INVESTIGATION_MODEL=gpt-4o-mini

# Phase 6 reproduction sandbox. See packages/reproduction/README.md.
REPRODUCTION_ENABLED=true
REPRODUCTION_TIMEOUT_MS=60000
REPRODUCTION_MEMORY_LIMIT=1g
REPRODUCTION_CPU_LIMIT=1
REPRODUCTION_MAX_OUTPUT_BYTES=100000
REPRODUCTION_DOCKER_IMAGE=incident-ai-reproduction-sandbox

NEXT_PUBLIC_API_URL=http://localhost:3001

POSTGRES_USER=incident_ai
POSTGRES_PASSWORD=incident_ai
POSTGRES_DB=incident_ai
