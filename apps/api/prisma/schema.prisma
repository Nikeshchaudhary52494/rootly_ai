generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  environments Environment[]
  apiKeys      ApiKey[]
  errorEvents  ErrorEvent[]
  incidents    Incident[]
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

model Environment {
  id        String          @id @default(uuid())
  projectId String
  name      String
  slug      String
  type      EnvironmentType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKeys     ApiKey[]
  errorEvents ErrorEvent[]
  incidents   Incident[]

  @@unique([projectId, slug])
}

model ApiKey {
  id            String    @id @default(uuid())
  projectId     String
  environmentId String
  name          String
  keyPrefix     String
  keyHash       String    @unique
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  errorEvents ErrorEvent[]
}

model ErrorEvent {
  id            String @id @default(uuid())
  projectId     String
  environmentId String
  apiKeyId      String

  eventId String @unique

  serviceName     String
  environmentName String
  release         String?

  errorName    String
  errorMessage String
  stackTrace   String?
  fingerprint  String

  metadata Json?

  timestamp  DateTime
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  incidentId String?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  apiKey      ApiKey      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  incident    Incident?   @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([environmentId])
  @@index([timestamp])
  @@index([receivedAt])
  @@index([errorName])
  @@index([fingerprint])
  @@index([incidentId])
}

enum IncidentStatus {
  OPEN
  RESOLVED
  IGNORED
}

model Incident {
  id             String @id @default(uuid())
  projectId      String
  environmentId  String
  sequenceNumber Int    @default(autoincrement())

  fingerprint String

  title        String
  errorName    String
  errorMessage String

  status IncidentStatus @default(OPEN)

  occurrenceCount Int @default(1)

  firstSeenAt DateTime
  lastSeenAt  DateTime

  latestEventId String

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  errorEvents ErrorEvent[]

  @@unique([projectId, environmentId, fingerprint])
  @@index([projectId, environmentId, status])
  @@index([lastSeenAt])
}
