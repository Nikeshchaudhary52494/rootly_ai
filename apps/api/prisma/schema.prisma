generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  environments Environment[]
  apiKeys      ApiKey[]
  errorEvents  ErrorEvent[]
  incidents    Incident[]
  repository   Repository?
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

model Environment {
  id        String          @id @default(uuid())
  projectId String
  name      String
  slug      String
  type      EnvironmentType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKeys     ApiKey[]
  errorEvents ErrorEvent[]
  incidents   Incident[]

  @@unique([projectId, slug])
}

model ApiKey {
  id            String    @id @default(uuid())
  projectId     String
  environmentId String
  name          String
  keyPrefix     String
  keyHash       String    @unique
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  errorEvents ErrorEvent[]
}

model ErrorEvent {
  id            String @id @default(uuid())
  projectId     String
  environmentId String
  apiKeyId      String

  eventId String @unique

  serviceName     String
  environmentName String
  release         String?

  errorName    String
  errorMessage String
  stackTrace   String?
  fingerprint  String

  metadata Json?

  timestamp  DateTime
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  incidentId String?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  apiKey      ApiKey      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  incident    Incident?   @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([environmentId])
  @@index([timestamp])
  @@index([receivedAt])
  @@index([errorName])
  @@index([fingerprint])
  @@index([incidentId])
}

enum IncidentStatus {
  OPEN
  RESOLVED
  IGNORED
}

model Incident {
  id             String @id @default(uuid())
  projectId      String
  environmentId  String
  sequenceNumber Int    @default(autoincrement())

  fingerprint String

  title        String
  errorName    String
  errorMessage String

  status IncidentStatus @default(OPEN)

  occurrenceCount Int @default(1)

  firstSeenAt DateTime
  lastSeenAt  DateTime

  latestEventId String

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  errorEvents ErrorEvent[]
  codeContext IncidentCodeContext?
  investigations Investigation[]
  reproductionRuns ReproductionRun[]
  fixAttempts FixAttempt[]
  pullRequests PullRequest[]

  @@unique([projectId, environmentId, fingerprint])
  @@index([projectId, environmentId, status])
  @@index([lastSeenAt])
}

enum RepositoryProvider {
  GITHUB
}

model Repository {
  id        String @id @default(uuid())
  projectId String @unique

  provider RepositoryProvider @default(GITHUB)

  owner String
  name  String

  repositoryUrl String @unique
  defaultBranch String

  encryptedAccessToken String

  connectedAt     DateTime  @default(now())
  lastValidatedAt DateTime?
  lastSyncedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files        RepositoryFile[]
  codeContexts IncidentCodeContext[]
  pullRequests PullRequest[]
}

enum RepositoryFileType {
  FILE
  DIRECTORY
}

model RepositoryFile {
  id           String @id @default(uuid())
  repositoryId String

  path String
  type RepositoryFileType
  sha  String

  lastSyncedAt DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, path])
  @@index([repositoryId])
}

enum IncidentCodeContextStatus {
  PENDING
  COLLECTING
  READY
  FAILED
}

model IncidentCodeContext {
  id           String  @id @default(uuid())
  incidentId   String  @unique
  repositoryId String?

  status IncidentCodeContextStatus @default(PENDING)

  generatedAt DateTime?

  errorMessage String?

  primaryFilePath   String?
  primaryLineNumber Int?

  summary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident   Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  repository Repository?          @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  files      IncidentCodeFile[]
  commits    IncidentCodeCommit[]
}

model IncidentCodeFile {
  id                    String @id @default(uuid())
  incidentCodeContextId String

  filePath     String
  lineNumber   Int?
  columnNumber Int?
  functionName String?

  content String

  contentStartLine Int
  contentEndLine   Int

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  incidentCodeContext IncidentCodeContext @relation(fields: [incidentCodeContextId], references: [id], onDelete: Cascade)

  @@index([incidentCodeContextId])
}

model IncidentCodeCommit {
  id                    String @id @default(uuid())
  incidentCodeContextId String

  sha         String
  message     String
  authorName  String
  authorEmail String
  committedAt DateTime

  filePath String

  createdAt DateTime @default(now())

  incidentCodeContext IncidentCodeContext @relation(fields: [incidentCodeContextId], references: [id], onDelete: Cascade)

  @@index([incidentCodeContextId])
}

enum InvestigationStatus {
  PENDING
  RUNNING
  LOADING_CONTEXT
  ANALYZING_ERROR
  ANALYZING_CODE
  ANALYZING_HISTORY
  GENERATING_HYPOTHESES
  EVALUATING_EVIDENCE
  GENERATING_REPORT
  COMPLETED
  FAILED
}

model Investigation {
  id         String @id @default(uuid())
  incidentId String

  status InvestigationStatus @default(PENDING)

  startedAt   DateTime?
  completedAt DateTime?

  model        String
  modelVersion String?

  finalConfidence Float?
  summary         String?
  recommendation  String?

  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  estimatedCost Float?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident   Incident                  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  hypotheses InvestigationHypothesis[]
  evidence   InvestigationEvidence[]
  reproductionRuns ReproductionRun[]
  fixAttempts FixAttempt[]

  @@index([incidentId])
  @@index([incidentId, createdAt])
}

enum HypothesisStatus {
  LIKELY
  POSSIBLE
  REJECTED
}

model InvestigationHypothesis {
  id              String @id @default(uuid())
  investigationId String

  title       String
  description String

  confidence Float
  rank       Int

  status HypothesisStatus

  createdAt DateTime @default(now())

  investigation Investigation           @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidence      InvestigationEvidence[]

  @@index([investigationId])
}

enum EvidenceType {
  SUPPORTING
  CONTRADICTING
}

enum EvidenceSourceType {
  ERROR
  SOURCE_CODE
  STACK_TRACE
  TEST
  GIT_COMMIT
  CONFIGURATION
}

model InvestigationEvidence {
  id              String @id @default(uuid())
  investigationId String
  hypothesisId    String

  type EvidenceType

  description String

  sourceType      EvidenceSourceType
  sourceReference String

  lineStart Int?
  lineEnd   Int?

  confidence Float

  createdAt DateTime @default(now())

  investigation Investigation           @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  hypothesis    InvestigationHypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)

  @@index([investigationId])
  @@index([hypothesisId])
}

enum ReproductionStatus {
  PENDING
  GENERATING_TEST
  CREATING_SANDBOX
  CHECKING_OUT
  INSTALLING
  RUNNING
  CLASSIFYING
  COMPLETED
  FAILED
}

enum ReproductionResult {
  REPRODUCED
  NOT_REPRODUCED
  INCONCLUSIVE
}

model ReproductionRun {
  id              String @id @default(uuid())
  incidentId      String
  investigationId String

  status ReproductionStatus @default(PENDING)
  result ReproductionResult?

  generatedTest        String?
  testFilePath         String?
  testExplanation      String?

  targetCommitSha String?

  stdout     String?
  stderr     String?
  exitCode   Int?
  durationMs Int?

  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident      Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  investigation Investigation      @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  tests         ReproductionTest[]
  fixAttempts   FixAttempt[]

  @@index([incidentId])
  @@index([investigationId])
  @@index([status])
  @@index([createdAt])
}

model ReproductionTest {
  id                String @id @default(uuid())
  reproductionRunId String

  filePath  String
  testName  String
  language  String
  framework String

  content     String
  explanation String?

  createdAt DateTime @default(now())

  reproductionRun ReproductionRun @relation(fields: [reproductionRunId], references: [id], onDelete: Cascade)

  @@index([reproductionRunId])
}

enum FixStatus {
  PENDING
  GENERATING_FIX
  VALIDATING_PATCH
  CREATING_SANDBOX
  CHECKING_OUT
  APPLYING_PATCH
  RUNNING_REPRODUCTION
  RUNNING_REGRESSION_TESTS
  VALIDATING
  COMPLETED
  FAILED
}

enum FixResult {
  FIX_VERIFIED
  FIX_REJECTED
  INCONCLUSIVE
}

model FixAttempt {
  id                String @id @default(uuid())
  incidentId        String
  investigationId   String
  reproductionRunId String

  status FixStatus  @default(PENDING)
  result FixResult?

  targetCommitSha String?

  patch             String?
  validatedPatchHash String?
  changedFiles      String[]
  explanation       String?
  validationSummary Json?

  stdout String?
  stderr String?

  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident        Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  investigation   Investigation   @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  reproductionRun ReproductionRun @relation(fields: [reproductionRunId], references: [id], onDelete: Cascade)
  patches         FixPatch[]
  pullRequests    PullRequest[]

  @@index([incidentId])
  @@index([investigationId])
  @@index([reproductionRunId])
  @@index([status])
  @@index([createdAt])
}

model FixPatch {
  id           String @id @default(uuid())
  fixAttemptId String

  filePath        String
  originalContent String
  patchedContent  String
  diff            String

  createdAt DateTime @default(now())

  fixAttempt FixAttempt @relation(fields: [fixAttemptId], references: [id], onDelete: Cascade)

  @@index([fixAttemptId])
}

enum PullRequestStatus {
  CREATING
  OPEN
  CLOSED
  MERGED
  FAILED
}

model PullRequest {
  id           String @id @default(uuid())
  incidentId   String
  fixAttemptId String
  repositoryId String

  branchName String
  baseBranch String
  commitSha  String?

  prNumber Int?
  prUrl    String?

  title String
  body  String

  status PullRequestStatus @default(CREATING)

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident   Incident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fixAttempt FixAttempt @relation(fields: [fixAttemptId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, branchName])
  @@index([incidentId])
  @@index([fixAttemptId])
  @@index([repositoryId])
  @@index([status])
}
