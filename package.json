{
  "name": "incident-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "demo-app"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=api",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "dev:demo": "npm run dev --workspace=demo-app",
    "build:sdk": "npm run build --workspace=@incident-ai/node",
    "build:agent": "npm run build --workspace=@incident-ai/agent",
    "build:reproduction": "npm run build --workspace=@incident-ai/reproduction",
    "test:api": "npm test --workspace=api",
    "test:sdk": "npm test --workspace=@incident-ai/node",
    "test:agent": "npm test --workspace=@incident-ai/agent",
    "test:reproduction": "npm test --workspace=@incident-ai/reproduction"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
